<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Vær</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #0f172a; color: #e2e8f0; min-height: 100vh; }
        .navbar-custom { background: rgba(15,23,42,0.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.08); }
        .weather-card {
            background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9));
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 1.5rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .weather-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,0.4); }
        .temp-big { font-size: 2.8rem; font-weight: 700; line-height: 1; }
        .weather-emoji { font-size: 2.5rem; }
        .city-name { font-size: 1.1rem; font-weight: 600; }
        .stat-label { font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
        .stat-value { font-size: 0.9rem; font-weight: 500; color: #94a3b8; }
        .search-box {
            background: rgba(30,41,59,0.8);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50px;
            color: #e2e8f0;
            padding: 0.75rem 1.5rem;
        }
        .search-box:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); background: rgba(30,41,59,1); color: #e2e8f0; }
        .search-box::placeholder { color: #475569; }
        .btn-search { border-radius: 50px; padding: 0.75rem 2rem; background: #3b82f6; border: none; font-weight: 600; }
        .btn-search:hover { background: #2563eb; }
        .answer-card {
            background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(30,41,59,0.9));
            border: 1px solid rgba(59,130,246,0.3);
            border-radius: 16px;
            padding: 1.5rem;
        }
        .section-title { font-size: 0.75rem; color: #475569; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-custom mb-5">
        <div class="container">
            <span class="navbar-brand fw-bold text-white fs-5">🌍 Vær</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" action="/Logout">
                    <button type="submit" class="btn btn-sm" style="color:#475569; border:1px solid #1e293b;">Logg ut</button>
                </form>
            }
        </div>
    </nav>
    <div class="container pb-5">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
