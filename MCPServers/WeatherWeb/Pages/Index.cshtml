@page
@model WeatherWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Værmelding";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <form method="post" class="d-flex gap-2 mb-4">
            <input type="text" name="Location" value="@Model.Location"
                   class="form-control" placeholder="Skriv inn et sted, f.eks. Oslo" required />
            <button type="submit" class="btn btn-primary px-4">Søk</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-warning">@Model.Error</div>
        }

        @if (Model.Weather != null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">📍 @Model.LocationDisplayName</h5>
                    <div class="row text-center g-3">
                        <div class="col-6 col-md-3">
                            <div class="fs-1 fw-bold text-primary">@Model.Weather.Temperature.ToString("F1")°</div>
                            <div class="text-muted small">Temperatur</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-semibold">@Model.Weather.WindSpeed.ToString("F1") m/s</div>
                            <div class="text-muted small">Vind fra @Model.Weather.WindDirection</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-4 fw-semibold">@Model.Weather.Humidity.ToString("F0")%</div>
                            <div class="text-muted small">Luftfuktighet</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fs-5 fw-semibold">@Model.Weather.WeatherType</div>
                            <div class="text-muted small">Værtype</div>
                            @if (Model.Weather.Precipitation.HasValue)
                            {
                                <div class="text-info small">@Model.Weather.Precipitation.Value.ToString("F1") mm nedbør</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Forecast.Count > 0)
            {
                <h6 class="text-muted mb-2">Neste @Model.Forecast.Count timer</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover bg-white rounded shadow-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Tid</th>
                                <th>Temp</th>
                                <th>Vind</th>
                                <th>Vær</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Forecast)
                            {
                                <tr>
                                    <td>@entry.Time</td>
                                    <td>@entry.Temperature.ToString("F1")°C</td>
                                    <td>@entry.WindSpeed.ToString("F1") m/s</td>
                                    <td>@entry.WeatherType</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
